# Ключ Gemini API (бесплатно): https://aistudio.google.com/apikey
# Нужен для перевода, а также для расшифровки, если нет ключа Groq.
GEMINI_API_KEY=

# Модель Gemini. Пусто — подбирается автоматически (Flash-Lite, у неё больше бесплатный лимит).
# Можно указать вручную, например gemini-2.5-flash. Если указанной модели нет, тоже подберётся сама.
GEMINI_MODEL=

# Ключ Groq (бесплатно): https://console.groq.com/keys
# Если задан, расшифровку делает Whisper на Groq — точнее таймкоды и меньше пропусков.
GROQ_API_KEY=

# Кто расшифровывает: auto (Groq, если есть ключ, иначе Gemini), groq или gemini
TRANSCRIBE_ENGINE=auto

# Максимальный размер загружаемого файла, МБ
MAX_UPLOAD_MB=2000

# Пароль для входа на сайт. Пусто — вход без пароля (нормально для своего компьютера).
# На хостинге задайте пароль в настройках сервиса, а не в коде.
APP_PASSWORD=
